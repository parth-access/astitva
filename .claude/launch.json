{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-local-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "DATABASE_URL": "postgres://localhost:5432/astitva_dev"
      }
    },
    {
      "name": "prod-local-db",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3002"
      ],
      "port": 3002,
      "env": {
        "DATABASE_URL": "postgres://localhost:5432/astitva_dev",
        "APP_URL": "http://localhost:3002",
        "CRON_SECRET": "local-cron-secret-for-testing-only"
      }
    },
    {
      "name": "prod-local-fake-razorpay",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3003"
      ],
      "port": 3003,
      "env": {
        "DATABASE_URL": "postgres://localhost:5432/astitva_dev",
        "APP_URL": "http://localhost:3003",
        "RAZORPAY_KEY_ID": "rzp_test_notarealkey",
        "RAZORPAY_KEY_SECRET": "not-a-real-secret",
        "RAZORPAY_WEBHOOK_SECRET": "local-webhook-secret"
      }
    }
  ]
}
