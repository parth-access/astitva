# Copy to .env (scripts, migrations) AND .env.local (Next.js). Never commit the copies.

# --- Database (Supabase) -------------------------------------------------------
# Supabase dashboard → Connect → "Session pooler" connection string (works on IPv4).
# Replace [YOUR-PASSWORD]; URL-encode special characters in it (@ → %40, # → %23, / → %2F).
# Do NOT add ?sslmode=... (see src/db/ssl.ts).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase's CA certificate: Project Settings → Database → SSL configuration → Download certificate.
# Save it inside the project as certs/supabase-ca.crt (that folder is git-ignored) or anywhere else.
DATABASE_CA_CERT_FILE=certs/supabase-ca.crt
# On Netlify/CI, paste the certificate's contents into DATABASE_CA_CERT instead of using a file.
# DATABASE_CA_CERT=

# Integration tests WIPE this database, so it must be a local throwaway database
# whose name contains "test". Never point it at Supabase.
DATABASE_URL_TEST=postgres://localhost:5432/astitva_test

APP_URL=http://localhost:3000

# --- Admin sign-in (Better Auth) ----------------------------------------------
# Signs sessions and encrypts 2FA secrets. Generate: openssl rand -base64 32
# Use a different value in each environment. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Account emails (password reset) go through Resend from this address. Without
# RESEND_API_KEY (local dev) the email is printed to the server log instead.
EMAIL_FROM="Astitva <hello@example.com>"

# --- Added in later milestones -----------------------------------------------
# Razorpay: Dashboard → switch to Test Mode → Account & Settings → API Keys.
# Test keys start rzp_test_ (no money moves; checkout shows "Test mode").
# Without both keys, checkout offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Choose any long random string; set the same one on the webhook in the dashboard
# (URL: <APP_URL>/api/webhooks/razorpay, events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed).
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
# Cloudinary: Console → Settings → API Keys. Put the real value in .env.local only;
# this file is public. Never commit a real key here.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Guards /api/cron/* (scheduled jobs). Same value as the CRON_SECRET secret in GitHub.
# Generate with: openssl rand -base64 32
CRON_SECRET=
